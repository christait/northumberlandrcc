---
import siteConfig from '../config/site.json';
const year = new Date().getFullYear();
const social = (siteConfig as { social?: { facebook?: string; instagram?: string } }).social ?? {};
const socialLinks = [
  { name: 'Facebook', href: social.facebook,
    path: 'M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.92 3.78-3.92 1.09 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.44 2.91h-2.34V22c4.78-.76 8.43-4.92 8.43-9.94Z' },
  { name: 'Instagram', href: social.instagram,
    path: 'M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16ZM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95C23.73 2.7 21.31.27 16.95.07 15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z' },
].filter((l) => l.href);

type NavChild = { label: string; href: string };
type NavItem = { label: string; href?: string; children?: NavChild[] };
const navLinks: NavChild[] = (siteConfig.nav as NavItem[]).flatMap((item) =>
  item.children ? item.children : item.href ? [{ label: item.label, href: item.href }] : []
);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h3 class="footer-title">{siteConfig.title}</h3>
      <p class="muted">{siteConfig.tagline}</p>
      <p class="muted small">A division of the Grand Imperial Conclave of The Masonic and Military Order of the Red Cross of Constantine and the Orders of the Holy Sepulchre and of St. John the Evangelist.</p>
    </div>
    <div>
      <h4 class="footer-title">Explore</h4>
      <ul>
        {navLinks.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4 class="footer-title">Contact</h4>
      <p class="muted">
        Divisional Recorder<br />
        <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
      </p>
      <p class="muted small">For enquiries about membership, please email the Divisional Recorder.</p>
      {socialLinks.length > 0 && (
        <ul class="social" aria-label="Follow us">
          {socialLinks.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener" aria-label={`${siteConfig.title} on ${l.name}`}>
                <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d={l.path} /></svg>
                <span>{l.name}</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
  <div class="container footer-base">
    <p class="muted small">© {year} {siteConfig.title}. All rights reserved.</p>
    <p class="muted small">
      <a href="/admin/">Editor sign-in</a> · <a href="/rss.xml">News feed</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: #1d1a17;
    color: #d8d2c4;
    padding: 3rem 0 1.5rem;
    margin-top: 4rem;
  }

  .site-footer h3,
  .site-footer h4 {
    color: #f3ebd6;
    font-size: 1rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-family: var(--font-sans);
    font-weight: 700;
  }

  .footer-title {
    margin-bottom: 0.6rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
  }

  .site-footer .muted {
    color: #b3ad9e;
  }

  .small {
    font-size: 0.85rem;
  }

  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .site-footer ul li {
    margin-bottom: 0.35rem;
  }

  .site-footer a {
    color: #e6d8b1;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: #fff;
    text-decoration: underline;
  }

  .site-footer .social {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }
  .site-footer .social a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .footer-base {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #2e2924;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
