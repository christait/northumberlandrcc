---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../config/site.json';
import { getDiary, upcomingOnly, fmtDiaryDate, typeLabel } from '../lib/diary';

const { data: hp } = await getEntry('homepage', 'index');

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const upcoming = (await getCollection('events', ({ data }) => !data.draft))
  .filter((e) => e.data.date.getTime() >= Date.now() - 86400000)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 3);

const nextMeetings = upcomingOnly(await getDiary()).slice(0, 4);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  });
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <img class="hero-logo" src="/img/logo.png" alt={`${siteConfig.title} crest`} width="160" height="160" />
      <span class="eyebrow">{hp.heroEyebrow}</span>
      <h1>{siteConfig.title}</h1>
      <p class="hero-lead">{hp.heroLead}</p>
      <div class="hero-actions">
        <a class="button" href={hp.cta1Href}>{hp.cta1Label}</a>
        <a class="button secondary" href={hp.cta2Href}>{hp.cta2Label}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid cols-3">
      {hp.cards.map((card) => (
        <article class="card">
          <span class="eyebrow">{card.eyebrow}</span>
          <h3>{card.heading}</h3>
          <p class="muted">{card.description}</p>
          <p><a href={card.linkHref}>{card.linkLabel} →</a></p>
        </article>
      ))}
    </div>
  </section>

  {nextMeetings.length > 0 && (
    <section class="section alt">
      <div class="container">
        <span class="eyebrow">Meetings Diary</span>
        <h2>Next Conclave meetings</h2>
        <div class="grid cols-2">
          {nextMeetings.map((m) => (
            <article class="card">
              <p class="muted small">{fmtDiaryDate(m.date, 'long')}{m.time ? ` · ${m.time}` : ''}</p>
              <h3>{m.conclave ? <a href={`/conclaves/${m.conclave}/`}>{m.meeting}</a> : m.meeting}</h3>
              <p class="muted">{m.where}{m.type !== 'meeting' ? ` — ${typeLabel[m.type]}` : ''}</p>
            </article>
          ))}
        </div>
        <p style="margin-top:1.5rem"><a href="/diary/">Full Meetings Diary →</a></p>
      </div>
    </section>
  )}

  {upcoming.length > 0 && (
    <section class="section">
      <div class="container">
        <span class="eyebrow">Upcoming</span>
        <h2>Forthcoming events</h2>
        <div class="grid cols-2">
          {upcoming.map((e) => (
            <article class="card">
              <p class="muted small">{fmtDate(e.data.date)}{e.data.location ? ` · ${e.data.location}` : ''}</p>
              <h3><a href={`/events/${e.slug}/`}>{e.data.title}</a></h3>
              {e.data.summary && <p class="muted">{e.data.summary}</p>}
            </article>
          ))}
        </div>
        <p style="margin-top:1.5rem"><a href="/events/">All events →</a></p>
      </div>
    </section>
  )}

  {news.length > 0 && (
    <section class="section alt">
      <div class="container">
        <span class="eyebrow">Latest</span>
        <h2>News &amp; notices</h2>
        <div class="grid cols-2">
          {news.map((n) => (
            <article class="card">
              <p class="muted small">{fmtDate(n.data.date)}</p>
              <h3><a href={`/news/${n.slug}/`}>{n.data.title}</a></h3>
              {n.data.summary && <p class="muted">{n.data.summary}</p>}
            </article>
          ))}
        </div>
        <p style="margin-top:1.5rem"><a href="/news/">All news →</a></p>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.85), rgba(251, 248, 243, 0.95)),
      radial-gradient(circle at 20% 0%, rgba(176, 138, 62, 0.18), transparent 40%),
      radial-gradient(circle at 80% 100%, rgba(139, 26, 26, 0.15), transparent 50%);
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--colour-border);
  }
  .hero-logo {
    display: block;
    width: 10rem;
    height: 10rem;
    margin: 0 auto 1.25rem;
  }
  .hero-inner {
    max-width: 48rem;
    text-align: center;
  }
  .hero-lead {
    font-size: 1.2rem;
    color: var(--colour-muted);
  }
  .hero-actions {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .small { font-size: 0.85rem; }
</style>
