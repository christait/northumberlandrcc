---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDiary, upcomingOnly, fmtDiaryDate, typeLabel } from '../../lib/diary';

export async function getStaticPaths() {
  const conclaves = await getCollection('conclaves');
  return conclaves.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const c = entry.data;
const dates = upcomingOnly(await getDiary()).filter((e) => e.conclave === entry.slug);
---

<BaseLayout title={c.name} description={`${c.name}${c.number ? ` No. ${c.number}` : ''} — a Conclave of the Division of the North East, Red Cross of Constantine.`}>
  <section class="section">
    <div class="container prose">
      <p><a href="/conclaves/">← All Conclaves</a></p>
      <span class="eyebrow">Conclave</span>
      <h1>{c.name}{c.number ? ` No. ${c.number}` : ''}</h1>
      <ul class="meta">
        {c.meetingPlace && <li><strong>Meeting place:</strong> {c.meetingPlace}</li>}
        {c.meetingDates && <li><strong>Meeting dates:</strong> {c.meetingDates}</li>}
        {c.meetingTime && <li><strong>Time:</strong> {c.meetingTime}</li>}
        {c.enthronement && <li><strong>Enthronement:</strong> {c.enthronement}</li>}
        {c.consecrated && <li><strong>Consecrated:</strong> {c.consecrated}</li>}
        {(c.recorder || c.recorderEmail) && (
          <li>
            <strong>Recorder:</strong>{' '}
            {c.recorder}
            {c.recorder && c.recorderEmail ? ' — ' : ''}
            {c.recorderEmail && <a href={`mailto:${c.recorderEmail}`}>{c.recorderEmail}</a>}
          </li>
        )}
      </ul>
      {dates.length > 0 && (
        <>
          <h2>Forthcoming meetings</h2>
          <ul class="dates">
            {dates.map((d) => (
              <li>
                <strong>{fmtDiaryDate(d.date, 'long')}</strong>{d.time ? `, ${d.time}` : ''}
                {d.type !== 'meeting' && <span class="tag"> — {typeLabel[d.type]}</span>}
              </li>
            ))}
          </ul>
        </>
      )}
      <hr />
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .meta { list-style: none; padding: 0; margin: 1rem 0; }
  .meta li { padding: 0.25rem 0; }
  .dates { list-style: none; padding: 0; }
  .dates li { padding: 0.3rem 0; border-bottom: 1px solid var(--colour-border); }
  .tag { color: var(--colour-primary); font-weight: 600; }
</style>
