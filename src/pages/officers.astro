---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const officers = (await getCollection('officers')).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
const groups = ['Divisional Officers', 'Sepulchre Guard'] as const;
---

<BaseLayout title="Officers" description="The Divisional Officers and Sepulchre Guard of the Division of the North East, Red Cross of Constantine, for 2026/2027.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">2026 / 2027</span>
      <h1>Divisional Officers</h1>
      <p class="muted">The Officers of the Division of the North East, appointed at the Annual Divisional Meeting. The number shown is each Officer’s Conclave.</p>

      {groups.map((g) => {
        const rows = officers.filter((o) => o.data.group === g);
        return rows.length > 0 && (
          <>
            {g !== 'Divisional Officers' && <h2 style="margin-top:2.5rem;">{g}</h2>}
            <div class="table-wrap" style="margin-top:1.5rem;">
              <table class="officers-table">
                <thead>
                  <tr>
                    <th scope="col">Office</th>
                    <th scope="col">Name</th>
                    <th scope="col">Conclave</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((o) => (
                    <tr>
                      <th scope="row">{o.data.office}</th>
                      <td>
                        {o.data.rank && <span>{o.data.rank} </span>}
                        {o.data.name ?? ''}
                      </td>
                      <td>{o.data.conclave ? `No. ${o.data.conclave}` : ''}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        );
      })}
    </div>
  </section>
</BaseLayout>

<style>
  .table-wrap { overflow-x: auto; }
  .officers-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--colour-surface);
    border: 1px solid var(--colour-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .officers-table th,
  .officers-table td {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--colour-border);
    vertical-align: top;
    font-size: 0.95rem;
  }
  .officers-table thead th {
    background: rgba(139, 26, 26, 0.06);
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--colour-primary-dark);
    letter-spacing: 0.04em;
  }
  .officers-table tbody tr:last-child th,
  .officers-table tbody tr:last-child td {
    border-bottom: none;
  }
  .officers-table tbody th {
    font-weight: 600;
  }
  .officers-table td:last-child { white-space: nowrap; }
</style>
